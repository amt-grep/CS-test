---
import Layout from "../layouts/Layout.astro";
import Page from "../components/pages/home";

export const prerender = true;
---

<Layout title="ClearSpend — Every transaction. Matched to its proof.">
  <Fragment slot="head">
    <meta name="description" content="ClearSpend reads the invoices and receipts already sitting in your Gmail and Drive, connects each one to the charge it belongs to, and gives your team a short list of what is still missing." />
    <meta property="og:title" content="ClearSpend — Every transaction. Matched to its proof." />
    <meta property="og:description" content="ClearSpend reads the invoices and receipts already sitting in your Gmail and Drive, connects each one to the charge it belongs to, and gives your team a short list of what is still missing." />
    <meta property="og:image" content="https://bolt.new/static/og_default.png" />
  </Fragment>
  <Page client:load />
</Layout>
